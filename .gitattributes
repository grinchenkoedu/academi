# Set default behavior to automatically handle line endings.
* text=auto

# Explicitly declare text files you want to always be LF.
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.mustache text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.xml text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
